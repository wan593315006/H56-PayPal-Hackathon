# PayPal-only configuration template. Copy locally to .env if you use that option.
# Keep this tracked file free of credential values. See docs/CREDENTIALS.md.

# A matched Sandbox REST app pair. Leave these empty in the public template.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# The executor supports this Sandbox configuration.
PAYPAL_ENVIRONMENT=sandbox

# Model credentials are process-environment only, using H56PAY_MODEL_KEY by default.
# Do not add a model-key assignment here: the .env parser accepts only the three
# PayPal names above. Enter model credentials as described in docs/CREDENTIALS.md.
