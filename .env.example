# Key names only. Copy this file to .env for real-mode runs and fill in values there.
# .env is git-ignored; this file never carries a value, not even a placeholder.

# PayPal REST application credentials (Sandbox first). Real-mode only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Which PayPal environment the client talks to: sandbox | live
PAYPAL_ENVIRONMENT=sandbox
